{
  "expo": {
    "name": "ReelMatch",
    "slug": "reelmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reelmatch",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.peteakhurst.reelmatch"
    },
    "android": {
      "package": "com.peteakhurst.reelmatch",
      "adaptiveIcon": {
        "backgroundColor": "#0a0612",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0612",
          "dark": {
            "backgroundColor": "#0a0612"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://reelmatch-proxy.peteakhurst.workers.dev",
      "supabaseUrl": "https://ygxepfmpnvpkfjcryvkr.supabase.co",
      "supabaseKey": "sb_publishable_ej7BE-ANNI7C74gAEj_ZUA_4Kw-2ntZ"
    }
  }
}
